# Copy to nas.local.env (gitignored) and fill in. Read by encrage-nas.ps1.
ENCRAGE_NAS_HOST=192.0.2.10
ENCRAGE_NAS_USER=your-ssh-user
# Private key for that user; ~ means your Windows profile folder.
ENCRAGE_NAS_KEY=~/.ssh/id_ed25519
# Folder on the NAS (relative to the SSH user's home) holding docker-compose.yml, .env and data/.
ENCRAGE_NAS_DIR=encrage
