ENCRAGE_ENV=development
ENCRAGE_DATABASE_PATH=./data/encrage.sqlite3
ENCRAGE_MEDIA_ROOT=./data/media
ENCRAGE_JWT_SECRET=replace-with-at-least-32-random-characters
ENCRAGE_ACCESS_TOKEN_MINUTES=60
ENCRAGE_REFRESH_TOKEN_DAYS=30
# Version 1 targets 4 MiB plaintext chunks; this permits authentication/envelope overhead.
ENCRAGE_MAX_CHUNK_BYTES=5242880
ENCRAGE_MAX_THUMBNAIL_BYTES=10485760
ENCRAGE_MAX_TOTAL_CHUNKS=1000000
ENCRAGE_MAX_PRIVATE_METADATA_CHARS=1000000
ENCRAGE_UPLOAD_TTL_HOURS=168
ENCRAGE_STREAM_BLOCK_BYTES=1048576
